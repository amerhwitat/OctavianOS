{
  "schema_version": "3.0",
  "product": "Chimera II OS",
  "purpose": "Unified native command and compatibility catalog derived from the public SS64 command-reference indexes.",
  "sources": [
    "https://ss64.com/",
    "https://ss64.com/bash/",
    "https://ss64.com/mac/",
    "https://ss64.com/nt/",
    "https://ss64.com/ps/",
    "https://ss64.com/vb/",
    "https://ss64.com/sql/",
    "https://ss64.com/access/",
    "https://ss64.com/tools/"
  ],
  "policy": "Store command names, namespaces, classifications and source URLs. Do not redistribute SS64 page prose.",
  "platforms": {
    "linux_bash": {
      "index": "https://ss64.com/bash/",
      "role": "primary POSIX/Linux compatibility layer"
    },
    "macos": {
      "index": "https://ss64.com/mac/",
      "role": "Darwin/macOS compatibility layer"
    },
    "windows_cmd": {
      "index": "https://ss64.com/nt/",
      "role": "Windows CMD compatibility layer"
    },
    "powershell": {
      "index": "https://ss64.com/ps/",
      "role": "PowerShell compatibility layer"
    },
    "vbscript": {
      "index": "https://ss64.com/vb/",
      "role": "Windows scripting compatibility namespace"
    },
    "sql_server": {
      "index": "https://ss64.com/sql/",
      "role": "T-SQL/database compatibility namespace"
    }
  },
