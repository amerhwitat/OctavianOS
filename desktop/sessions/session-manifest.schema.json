{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octavianos.example/schemas/session-manifest.schema.json",
  "title": "OctavianOS desktop session manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "launch", "architectures", "display_backend", "readiness_probe", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}}
      }
    },
    "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "display_backend": {"type": "string", "enum": ["wayland", "x11", "web", "remote", "vm"]},
    "requires": {"type": "array", "items": {"type": "string"}},
    "license": {"type": "string"},
    "readiness_probe": {"type": "string", "minLength": 1},
    "launch_method": {"type": "string", "enum": ["native", "compatibility", "container", "vm", "remote", "web"]},
    "status": {"type": "string", "enum": ["prototype", "experimental", "supported", "unavailable"]}
  }
}
