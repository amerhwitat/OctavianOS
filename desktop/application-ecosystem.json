  "native_integration_requirements": [
    "Package manifest, version, architecture, dependency graph and upstream provenance",
    "License and trademark review plus bundled third-party notices",
    "Target-native build or documented compatible runtime; no assumed binary compatibility",
    "Desktop entry, icon, categories, MIME/file associations and Open With registration",
    "Permission declarations, sandbox profile, signature verification and update/rollback policy",
    "File picker, drag-and-drop, clipboard, accessibility and localization integration",
    "Hardware acceleration, input, audio/video and device capability detection with fallback",
    "Automated install/launch/open-file/quit/update tests on each claimed target"
  ]
}
