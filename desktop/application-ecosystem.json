{
  "schema": "CHM-DESKTOP-APPLICATION-ECOSYSTEM-1",
  "updated_utc": "2026-10-19",
  "purpose": "Cross-platform desktop application discovery and integration plan for ChimeraIIOS and OctavianOS. This catalog is broad but not exhaustive; it does not imply third-party apps are bundled, ported, licensed for redistribution, or runnable on Koronos.",
  "target_desktops": [
    "Aurora Wayland Glass Desktop",
    "Marine Desktop"
  ],
  "host_platform_reference": [
    "Windows",
    "Linux",
    "macOS"
  ],
  "integration_policy": {
    "source_first": "Prefer upstream open-source source packages and native ports; preserve upstream licenses, trademarks, codecs, assets and notices.",
    "app_states": [
      "preview-implemented",
      "catalog-only",
      "port-and-package-required",
      "proprietary-external"
    ],
    "launch_policy": "Only apps marked preview-implemented are implemented in the browser preview. Catalog-only apps open their upstream project page. Native launch requires a verified package, compatible ABI/runtime, trusted session adapter, permission policy and target test.",
    "compatibility": "Windows PE/Win32, Linux ELF/POSIX, macOS Mach-O/AppKit and proprietary DRM/anti-cheat are not automatically interchangeable. Compatibility layers and emulators must be individually tested."
  },
