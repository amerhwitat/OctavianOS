{
  "schema_version": 2,
  "delivery": "mixed-remote-catalog-and-embedded-offline-artwork",
  "note": "The wallpaper catalog entries below retain their remote Unsplash source metadata. Original project artwork is also bundled offline as Base64 data URIs in desktop/artwork/embedded-wallpapers.js; this bundle does not imply that the remote catalog photographs themselves are embedded.",
  "wallpapers": [
    {
      "id": "aurora-ocean-night",
      "desktop": "aurora-wayland-glass",
      "title": "Green aurora over a calm ocean",
      "photographer": "Kristaps Ungurs",
      "source_page": "https://unsplash.com/photos/aurora-borealis-over-calm-ocean-2xx7so0d3cY",
      "image_url": "https://images.unsplash.com/photo-1786335091902-eb0166246cbe?auto=format&fit=crop&w=2400&q=85",
      "license": "Unsplash License",
      "license_url": "https://unsplash.com/license",
      "fallback": "radial-gradient(ellipse at 60% 20%, #28c9b8 0, transparent 38%), linear-gradient(135deg, #061c39, #092d49 55%, #03131f)"
    },
    {
      "id": "marine-turtle-reef",
      "desktop": "marine",
      "title": "Sea turtle over coral reef",
      "photographer": "Kristin Hoel",
      "source_page": "https://unsplash.com/photos/a-sea-turtle-swimming-over-a-coral-reef-pyw39Zn6wWo",
      "image_url": "https://images.unsplash.com/photo-1717293520171-b1d8b5d5e3f2?auto=format&fit=crop&w=2400&q=85",
      "license": "Unsplash License",
      "license_url": "https://unsplash.com/license",
      "fallback": "radial-gradient(ellipse at 65% 20%, #1db8cf 0, transparent 42%), linear-gradient(145deg, #03233e, #086b80 60%, #031b2c)"
    }
  ],
  "embedded_bundle": {
    "path": "desktop/artwork/embedded-wallpapers.js",
    "format": "JavaScript containing Base64 data URIs",
    "no_network_required": true,
    "assets": [
      {
        "id": "chimeraAurora",
        "mime": "image/svg+xml",
        "source": "ChimeraIIOS desktop/aurora/assets/chimera-infinite-research-horizon-3840x2160.svg"
      },
      {
        "id": "octavianAurora",
        "mime": "image/svg+xml",
        "source": "desktop/aurora/assets/octavian-octopus-aurora.svg"
      },
      {
        "id": "marine",
        "mime": "image/svg+xml",
        "source": "desktop/marine/assets/marine-desktop.svg"
      },
      {
        "id": "auroraGlassJpeg",
        "mime": "image/jpeg",
        "source": "ChimeraIIOS boot/visual/aurora-wayland-glass.jpg.b64"
      }
    ],
    "activation": "Add data-embedded-wallpaper=<asset id> to an img or background container; bundle exports OS_EMBEDDED_ARTWORK and applyOSEmbeddedArtwork."
  }
}
