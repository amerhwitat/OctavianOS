#!/bin/bash
# Aurora session entry point (systemd ExecStart / tty1 autologin).
# The browser shell is a hosted Linux desktop; native Koronos session startup
# remains a separate release gate.
set -u

PROFILE_FILE="${AURORA_PROFILE_FILE:-/etc/aurora/profile}"
RUNTIME_FILE="${AURORA_RUNTIME_PROFILE_FILE:-/run/aurora/profile}"
CMDLINE_FILE="${AURORA_CMDLINE_FILE:-/proc/cmdline}"
SESSION_CONF="${AURORA_SESSION_CONF:-/etc/aurora/session.conf}"
profile_override=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --profile)
      [ "$#" -ge 2 ] || { echo "usage: aurora-session [--profile jasper|gates|aurora|marine]" >&2; exit 2; }
      profile_override="$2"
      shift 2
      ;;
    --help|-h)
      echo "Usage: aurora-session [--profile jasper|gates|aurora|marine]"
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      echo "Usage: aurora-session [--profile jasper|gates|aurora|marine]" >&2
      exit 2
      ;;
  esac
done

valid_profile() {
  case "$1" in jasper|gates|aurora|marine) return 0 ;; *) return 1 ;; esac
}
read_profile() {
  file=$1
  [ -s "$file" ] || return 1
  value="$(head -n1 "$file" | tr -d '[:space:]')"
  valid_profile "$value" || return 1
  printf '%s' "$value"
}

profile=""
if [ -n "$profile_override" ]; then
  valid_profile "$profile_override" || { echo "invalid desktop profile: $profile_override" >&2; exit 2; }
  profile="$profile_override"
elif value="$(read_profile "$RUNTIME_FILE" 2>/dev/null)"; then
  profile="$value"
else
  cmdline_profile=""
  if [ -r "$CMDLINE_FILE" ]; then
    for token in $(cat "$CMDLINE_FILE"); do
      case "$token" in
        aurora.profile=*) cmdline_profile="${token#aurora.profile=}" ;;
        chm.desktop=*) cmdline_profile="${token#chm.desktop=}" ;;
      esac
    done
  fi
  if valid_profile "$cmdline_profile"; then
    profile="$cmdline_profile"
  elif value="$(read_profile "$PROFILE_FILE" 2>/dev/null)"; then
    profile="$value"
  else
    profile="aurora"
  fi
fi

mkdir -p "$(dirname "$RUNTIME_FILE")" 2>/dev/null || true
printf '%s\n' "$profile" > "$RUNTIME_FILE" 2>/dev/null || true

# Marine is a distinct desktop implementation, not merely an Aurora theme
# query parameter. Jasper/Gates remain Aurora-shell interaction profiles.
if [ "$profile" = "marine" ]; then
  uri="file:///opt/aurora/desktop/marine/index.html"
  append_profile=0
else
  uri="file:///opt/aurora/desktop/aurora-shell/index.html"
  append_profile=1
fi
# shellcheck disable=SC1091
[ -r "$SESSION_CONF" ] && . "$SESSION_CONF"
uri="${AURORA_DESKTOP_URI:-$uri}"
if [ "$append_profile" -eq 1 ]; then
  case "$uri" in *\?*) sep='&' ;; *) sep='?' ;; esac
  uri="${uri}${sep}profile=${profile}"
fi

export LIBGL_ALWAYS_SOFTWARE=1
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export WEBKIT_DISABLE_DMABUF_RENDERER=1
export GDK_BACKEND=x11
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-live}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
xsetroot -solid '#071a2b' 2>/dev/null || true
xset -dpms 2>/dev/null || true
xset s off 2>/dev/null || true

if grep -q "session=classic" "$CMDLINE_FILE" 2>/dev/null; then
  for w in /usr/share/backgrounds/*/wp01.jpg; do [ -f "$w" ] && feh --bg-fill "$w"; done
  exec openbox
fi

# GTK's fullscreen request is an EWMH message. A window manager must be ready
# before the WebKit kiosk starts, otherwise the desktop remains windowed.
if ! command -v openbox >/dev/null 2>&1 || ! command -v xprop >/dev/null 2>&1; then
  echo "[Aurora][FATAL] Openbox and xprop are required for fullscreen desktop mode." >&2
  exit 1
fi
openbox --sm-disable >/tmp/aurora-openbox.log 2>&1 &
wm_pid=$!
wm_ready=0
for _ in $(seq 1 50); do
  if xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -Eq 'window id # 0x[[:xdigit:]]+'; then
    wm_ready=1
    break
  fi
  if ! kill -0 "$wm_pid" 2>/dev/null; then
    cat /tmp/aurora-openbox.log >&2 || true
    echo "[Aurora][FATAL] Openbox exited before registering as the window manager." >&2
    exit 1
  fi
  sleep 0.1
done
if [ "$wm_ready" -ne 1 ]; then
  cat /tmp/aurora-openbox.log >&2 || true
  echo "[Aurora][FATAL] Openbox did not become ready; refusing to start a windowed desktop." >&2
  kill "$wm_pid" 2>/dev/null || true
  exit 1
fi
echo "[Aurora] Openbox ready; starting fullscreen desktop (profile: $profile, uri: $uri)."
exec /usr/bin/python3 /usr/local/bin/aurora-kiosk.py "$uri"
