  ],
  "required_native_platform_services": [
    "ELF loader and process lifecycle",
    "scheduler-owned PID/task identity and safe context switching",
    "ring-3 syscall entry/return with user-origin validation",
    "process-owned virtual address spaces, user stacks, W^X and cleanup",
    "VFS, mount layer, file descriptors, read/write/stat/directory operations",
    "IPC, wait/wake, signals or a documented equivalent, and process reaping",
    "device discovery and permission-enforced device services",
    "network stack, DNS, sockets, TLS and certificate storage",
    "graphics API, compositor/window manager, input, fonts and clipboard",
    "audio API, multimedia decode/encode, timers and power management",
    "package manager with dependency resolution, signatures, permissions, sandboxing, transactions and rollback",
    "installer partition/filesystem operations and recovery repair primitives"
  ],
  "acceptance": {
    "production_init_targets": [
      "live",
      "installer",
      "recovery"
    ],
    "firmware": [
      "bios",
      "uefi"
    ],
    "required_cases": 6,
    "must_use_unchanged_production_verifier": true,
    "required_evidence": [
      "real target-specific init ELF",
      "CPL3-originated syscall acknowledgement",
      "same nonzero scheduler-owned PID in readiness handshake",
      "raw per-case serial/debug trace",
      "artifact identity and firmware/target provenance"
    ],
    "separate_acceptance": [
      "Live-to-Aurora desktop startup",
      "installer completion/reboot/installed boot",
      "real recovery operation",
      "AP startup and concurrent per-CPU SMP"
    ],
    "release_status_until_all_pass": "BLOCKED"
  }
}
