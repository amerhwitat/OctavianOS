{
  "schema_version": 1,
  "project": "ChimeraIIOS / OctavianOS native userspace ecosystem",
  "policy": {
    "source_policy": "Prefer upstream-maintained free/open-source projects; import source only after reviewing exact revision, license, dependency licenses, notices, trademarks, bundled assets, and build requirements.",
    "no_false_support_claims": true,
    "native_os_boundary": "Host, browser, JavaFX, WASM, compatibility, and emulator applications are not native Koronos applications unless actually built for and executed by the target runtime.",
    "release_rule": "Do not publish an application as native-supported until its package builds reproducibly, dependencies resolve, permissions are enforced, launch/exit works, and target-specific tests pass."
  },
  "application_families": [
    {
      "id": "web-browser",
      "examples": [
        {
          "name": "Firefox",
          "source": "https://github.com/mozilla-firefox/firefox",
          "license_review": "Review upstream licensing and all build dependencies"
        }
      ],
      "capabilities": [
        "HTML/CSS/JavaScript",
        "TLS",
        "downloads",
        "tabs",
        "extensions"
      ],
      "status": "candidate_only",
      "native_dependencies": [
        "network stack",
        "TLS and certificate store",
        "font and text stack",
        "graphics/compositor",
        "sandbox/process model"
      ]
    },
    {
      "id": "office",
      "examples": [
        {
          "name": "LibreOffice",
          "source": "https://github.com/LibreOffice/core",
          "license_review": "Review MPL/LGPL/GPL components and notices"
        }
      ],
      "capabilities": [
        "word processing",
        "spreadsheets",
        "presentations",
        "PDF export"
      ],
      "status": "candidate_only",
      "native_dependencies": [
        "GUI toolkit",
        "font stack",
        "printing",
        "file dialogs",
        "document import/export libraries"
      ]
    },
    {
