  "policy": {
    "status_values": ["native-default", "installed", "provider-required", "unsupported"],
    "rules": [
      "Only native-default or installed entries with executable launch targets may be shown as available.",
      "Check upstream license and supported architecture before packaging; license labels are indicative and must be verified against upstream metadata.",
      "Do not bundle third-party software without preserving its license, notices, source availability obligations, and security update path.",
      "Terminal emulator and shell are separate layers; a terminal must not be mistaken for a shell.",
