  "rules": [
    "A CPU emulator running guest instructions does not establish native OS support.",
    "QEMU machine availability is not proof that the OS boots on that machine.",
    "No target may be release_supported=true without linked, reproducible acceptance evidence.",
    "Never load an x86_64 ELF kernel or userspace payload on a non-x86_64 target.",
    "Mobile device support requires device-specific drivers, firmware interfaces, power management, secure update and recovery."
  ]
}
