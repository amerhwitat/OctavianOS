{
  "schema": "chimera-driver-source-catalog-v2",
  "sources": [
    {
      "platform": "Linux",
      "kind": "kernel-source",
      "url": "https://github.com/torvalds/linux",
      "license": "GPL-2.0-only",
      "integration": "port/adapt compatible subsystems with provenance"
    },
    {
      "platform": "Windows",
      "kind": "official-driver-samples",
      "url": "https://github.com/microsoft/Windows-driver-samples",
      "license": "MS-PL",
      "integration": "reference/build samples; port interfaces"
    },
    {
      "platform": "Windows",
      "kind": "WDK",
      "url": "https://learn.microsoft.com/en-us/windows-hardware/drivers/download-the-wdk",
      "license": "Microsoft SDK/WDK terms",
      "integration": "Windows-only build/reference environment"
    },
    {
      "platform": "Windows",
      "kind": "rust-driver-samples",
      "url": "https://github.com/microsoft/Windows-rust-driver-samples",
      "license": "repository-specific",
      "integration": "Rust driver architecture reference"
    },
    {
      "platform": "macOS",
      "kind": "DriverKit",
      "url": "https://developer.apple.com/documentation/driverkit",
      "license": "Apple SDK terms",
      "integration": "API/reference; build/sign on supported Apple toolchains"
    },
    {
      "platform": "macOS",
      "kind": "System Extensions",
      "url": "https://developer.apple.com/documentation/SystemExtensions",
      "license": "Apple SDK terms",
      "integration": "API/reference; entitlement/signing required"
    }
  ],
  "families": [
    "PCI",
    "PCIe",
    "USB",
    "xHCI",
    "EHCI",
    "UHCI",
    "NVMe",
    "AHCI",
