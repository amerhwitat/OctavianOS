{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "CHM-MOBILE-SYNC-3",
  "source_of_truth": "ChimeraIIOS/main",
  "shared_components": [
    "kernel/koronos",
    "kernel/include/chimera/microkernel.h",
    "system/security",
    "system/database",
    "services/apache",
    "toolchains",
    "appcenter/catalog",
    "Aurora runtime"
  ],
  "microkernel": {
    "capability_ipc": true,
    "endpoint_ipc": true,
    "syscall_abi": true,
    "mixed_width_ipc": true,
    "endianness": {
      "native_abi": "explicit-per-target",
      "ipc_wire": "little-endian canonical",
      "cross_endian_messages": "encode/decode at boundary",
      "mixed_endian_guest_support": "backend-specific and unvalidated"
    }
  },
  "android": {
    "hosted": true,
    "bare_metal_profiled": true,
    "native_toolchain": "Android NDK Clang",
    "deployment": [
      "apk",
      "aab"
    ],
    "debug_transport": [
      "adb",
      "fastboot",
      "recovery"
    ],
    "requires_device_boot_bundle": true
  },
  "apple": {
    "hosted": true,
    "bare_metal_profiled": false,
    "native_toolchain": "Apple Clang/Xcode",
    "deployment": [
      "ipa/archive"
    ],
    "debug_transport": [
      "xcodebuild"
    ],
    "requires_signed_deployment": true
  },
  "shared_security": {
    "secure_boot": "respect",
    "verified_boot": "respect",
    "signature_verification": "required",
    "flash_confirmation": "required",
    "rollback_metadata": "required",
    "generic_partition_flash": "forbidden"
  },
  "endianness": {
    "contract": "system/architecture/endianness.json",
    "shared_header": "kernel/include/chimera/endianness.h",
    "policy": "SoC/runtime ABI determines native order; guest/emulator order is explicit; hosted Android/iOS APIs are not assumed to match guest byte order",
    "status": "contract-defined; device-specific endian behavior requires target validation"
  }
}
