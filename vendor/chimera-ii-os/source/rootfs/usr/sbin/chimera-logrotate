#!/usr/bin/env bash
set -Eeuo pipefail

LOGDIR="${CHIMERA_LOGDIR:-/var/log}"
MAX_SIZE="${CHIMERA_LOG_MAX_SIZE:-10485760}"
MAX_FILES="${CHIMERA_LOG_MAX_FILES:-10}"

rotate_one() {
    local file="$1"
    local size

    [[ -f "$file" ]] || return 0

    size="$(stat -c '%s' "$file" 2>/dev/null || echo 0)"

    (( size < MAX_SIZE )) && return 0

    local n
    for ((n=MAX_FILES-1; n>=1; n--)); do
        if [[ -f "$file.$n" ]]; then
            if (( n == MAX_FILES-1 )); then
                rm -f -- "$file.$n"
            else
                mv -f -- "$file.$n" "$file.$((n+1))"
            fi
        fi
    done

    mv -f -- "$file" "$file.1"
    : > "$file"

    chmod 0640 "$file" 2>/dev/null || true
}

while IFS= read -r -d '' file; do
    rotate_one "$file"
done < <(
    find "$LOGDIR" -maxdepth 2 -type f \
        \( -name '*.log' -o -name '*.jsonl' \) \
        -print0 2>/dev/null
)
