    "kitty":{"repo":"https://github.com/kovidgoyal/kitty","build":"source/package","license":"GPL-3.0"},
    "wezterm":{"repo":"https://github.com/wezterm/wezterm","build":"cargo","license":"MIT"},
    "ghostty":{"repo":"https://github.com/ghostty-org/ghostty","build":"zig","license":"MIT"},
    "foot":{"repo":"https://codeberg.org/dnkl/foot","build":"meson","license":"MIT"},
    "contour":{"repo":"https://github.com/contour-terminal/contour","build":"cmake","license":"Apache-2.0"},
    "xterm":{"source":"https://invisible-island.net/xterm/","build":"autotools-or-package"},
    "gnome-terminal":{"source":"https://gitlab.gnome.org/GNOME/gnome-terminal","build":"meson-or-package"},
    "konsole":{"source":"https://invent.kde.org/utilities/konsole","build":"cmake-or-package"},
