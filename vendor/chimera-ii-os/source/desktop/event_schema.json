{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chimera II Desktop Event",
  "type": "object",
  "required": ["type", "timestamp_ns", "device_id"],
  "properties": {
    "type": {"type":"string","enum":["window_create","window_close","window_move","window_resize","window_minimize","window_maximize","window_restore","focus_in","focus_out","key_down","key_up","text_input","pointer_move","pointer_down","pointer_up","wheel","touch_begin","touch_update","touch_end","gesture","drag_begin","drag_update","drag_end","menu_open","menu_command","clipboard","display_change","theme_change","accessibility","quit"]},
    "timestamp_ns": {"type":"integer","minimum":0},
    "device_id": {"type":"string"},
    "window_id": {"type":"string"},
    "x": {"type":"number"}, "y": {"type":"number"},
    "dx": {"type":"number"}, "dy": {"type":"number"},
    "key": {"type":"string"}, "text": {"type":"string"},
    "modifiers": {"type":"integer","minimum":0},
    "buttons": {"type":"integer","minimum":0},
    "payload": {"type":"object","additionalProperties":true}
  }
}
