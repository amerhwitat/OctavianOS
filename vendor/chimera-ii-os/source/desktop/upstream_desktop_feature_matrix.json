  "common_capabilities": [
    {
      "id": "session-manager",
      "status": "planned",
      "acceptance": "Start and stop a real user session; recover from compositor failure."
    },
    {
      "id": "window-management",
      "status": "planned",
      "acceptance": "Create, focus, move, resize, minimize, maximize, tile and close real windows."
    },
    {
      "id": "input-routing",
      "status": "planned",
      "acceptance": "Keyboard, pointer, touch/gesture and accessibility input with focus and hit-testing tests."
    },
    {
      "id": "launcher-search",
      "status": "planned",
      "acceptance": "Discover only installed applications; launch process and report errors."
    },
    {
      "id": "panel-dock",
      "status": "planned",
      "acceptance": "Task/window list reflects actual processes/windows; pinning persists across sessions."
    },
    {
      "id": "notifications",
      "status": "planned",
      "acceptance": "Permission-aware notification service with focus and do-not-disturb controls."
    },
    {
      "id": "workspace-multidisplay",
      "status": "planned",
      "acceptance": "Workspace switching and display hotplug/mode changes tested against supported compositor."
    },
    {
      "id": "settings-theme",
      "status": "planned",
      "acceptance": "Persist themes, fonts, scale, language, RTL, reduced motion and contrast."
    },
    {
      "id": "file-manager",
      "status": "planned",
      "acceptance": "Uses actual VFS/filesystem APIs and honors permissions; no mock file actions."
    },
    {
      "id": "accessibility",
      "status": "planned",
      "acceptance": "Keyboard-only operation, screen-reader/accessibility tree, focus order and scaling tests."
    },
    {
      "id": "sound-power-network",
      "status": "planned",
      "acceptance": "Controls call real OS services and clearly report unsupported hardware."
    },
    {
      "id": "session-security",
      "status": "planned",
      "acceptance": "User isolation, app launch policy, lock screen and authentication integration."
    },
    {
      "id": "crash-recovery",
      "status": "planned",
      "acceptance": "Compositor/app crash isolation, session logs and safe restart."
    },
    {
      "id": "packaging-updates",
      "status": "planned",
      "acceptance": "Signed/provenanced packages, transactional update/rollback, license manifest."
    }
  ]
