{
  "$schema": "CHM-FILE-ASSOCIATIONS-2",
  "version": 2,
  "default_policy": "prefer-explicit-user-choice",
  "applications": {
    "aurora-files": {"desktop_id":"aurora-files.desktop","capabilities":["browse","properties","rename","copy","move","delete","permissions","open-with","directory-summary"]},
    "aurora-media-player": {"desktop_id":"aurora-media-player.desktop","capabilities":["audio","image","playlist","metadata","properties"]},
    "aurora-video-player": {"desktop_id":"aurora-video-player.desktop","capabilities":["video","audio","subtitles","playlist","metadata","properties"]},
    "aurora-editor": {"desktop_id":"aurora-editor.desktop","capabilities":["text","source","markup"]},
    "aurora-browser": {"desktop_id":"aurora-browser.desktop","capabilities":["html","http","https"]}
  },
  "mime_types": {
    "inode/directory":["aurora-files.desktop"],
    "text/plain":["aurora-editor.desktop"],
    "text/markdown":["aurora-editor.desktop"],
    "text/csv":["aurora-editor.desktop"],
    "text/xml":["aurora-editor.desktop"],
    "text/html":["aurora-browser.desktop","aurora-editor.desktop"],
    "text/css":["aurora-editor.desktop"],
    "text/javascript":["aurora-editor.desktop"],
    "application/json":["aurora-editor.desktop"],
    "application/xml":["aurora-editor.desktop"],
    "application/pdf":["aurora-files.desktop"],
    "application/rtf":["aurora-editor.desktop"],
    "application/msword":["aurora-files.desktop"],
    "application/vnd.openxmlformats-officedocument.wordprocessingml.document":["aurora-files.desktop"],
    "application/vnd.ms-excel":["aurora-files.desktop"],
    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet":["aurora-files.desktop"],
    "application/vnd.ms-powerpoint":["aurora-files.desktop"],
    "application/vnd.openxmlformats-officedocument.presentationml.presentation":["aurora-files.desktop"],
    "application/epub+zip":["aurora-files.desktop"],
    "application/zip":["aurora-files.desktop"],
    "application/gzip":["aurora-files.desktop"],
    "application/x-tar":["aurora-files.desktop"],
    "application/x-7z-compressed":["aurora-files.desktop"],
    "application/x-rar":["aurora-files.desktop"],
    "application/x-bzip2":["aurora-files.desktop"],
    "application/x-xz":["aurora-files.desktop"],
    "application/x-iso9660-image":["aurora-files.desktop"],
    "application/x-apple-diskimage":["aurora-files.desktop"],
    "application/x-executable":["aurora-files.desktop"],
    "application/x-sh":["aurora-editor.desktop"],
    "application/x-shellscript":["aurora-editor.desktop"],
    "application/x-python":["aurora-editor.desktop"],
    "application/x-c":["aurora-editor.desktop"],
    "application/x-c++":["aurora-editor.desktop"],
    "application/x-java":["aurora-editor.desktop"],
    "application/wasm":["aurora-files.desktop"],
    "image/jpeg":["aurora-media-player.desktop"],
    "image/png":["aurora-media-player.desktop"],
    "image/gif":["aurora-media-player.desktop"],
    "image/webp":["aurora-media-player.desktop"],
    "image/tiff":["aurora-media-player.desktop"],
    "image/bmp":["aurora-media-player.desktop"],
    "image/svg+xml":["aurora-media-player.desktop","aurora-editor.desktop"],
    "audio/mpeg":["aurora-media-player.desktop"],
    "audio/ogg":["aurora-media-player.desktop"],
    "audio/wav":["aurora-media-player.desktop"],
    "audio/flac":["aurora-media-player.desktop"],
    "audio/mp4":["aurora-media-player.desktop"],
    "audio/aac":["aurora-media-player.desktop"],
    "audio/x-matroska":["aurora-media-player.desktop"],
    "video/mp4":["aurora-video-player.desktop"],
    "video/webm":["aurora-video-player.desktop"],
    "video/x-matroska":["aurora-video-player.desktop"],
    "video/quicktime":["aurora-video-player.desktop"],
    "video/mpeg":["aurora-video-player.desktop"],
    "video/x-msvideo":["aurora-video-player.desktop"],
    "video/x-flv":["aurora-video-player.desktop"],
    "application/ogg":["aurora-video-player.desktop","aurora-media-player.desktop"]
  },
  "extensions": {
    ".txt":"text/plain",".md":"text/markdown",".csv":"text/csv",".xml":"application/xml",".html":"text/html",".htm":"text/html",".css":"text/css",".js":"text/javascript",".json":"application/json",
    ".pdf":"application/pdf",".rtf":"application/rtf",".doc":"application/msword",".docx":"application/vnd.openxmlformats-officedocument.wordprocessingml.document",".xls":"application/vnd.ms-excel",".xlsx":"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",".ppt":"application/vnd.ms-powerpoint",".pptx":"application/vnd.openxmlformats-officedocument.presentationml.presentation",".epub":"application/epub+zip",
    ".zip":"application/zip",".gz":"application/gzip",".tgz":"application/gzip",".tar":"application/x-tar",".7z":"application/x-7z-compressed",".rar":"application/x-rar",".bz2":"application/x-bzip2",".xz":"application/x-xz",".iso":"application/x-iso9660-image",".dmg":"application/x-apple-diskimage",
    ".sh":"application/x-shellscript",".bash":"application/x-shellscript",".py":"application/x-python",".c":"application/x-c",".h":"text/plain",".cpp":"application/x-c++",".hpp":"text/plain",".java":"application/x-java",".rs":"text/plain",".go":"text/plain",".js":"text/javascript",".ts":"text/javascript",".wasm":"application/wasm",
    ".jpg":"image/jpeg",".jpeg":"image/jpeg",".png":"image/png",".gif":"image/gif",".webp":"image/webp",".tif":"image/tiff",".tiff":"image/tiff",".bmp":"image/bmp",".svg":"image/svg+xml",
    ".mp3":"audio/mpeg",".ogg":"audio/ogg",".wav":"audio/wav",".flac":"audio/flac",".m4a":"audio/mp4",".aac":"audio/aac",".mka":"audio/x-matroska",
    ".mp4":"video/mp4",".webm":"video/webm",".mkv":"video/x-matroska",".mov":"video/quicktime",".mpeg":"video/mpeg",".mpg":"video/mpeg",".avi":"video/x-msvideo",".flv":"video/x-flv",".ogv":"video/ogg"
  },
  "actions": {
    "open":["default","open-with","new-window","properties"],
    "media":["play","enqueue","add-to-library","properties"],
    "video":["play","enqueue","add-to-library","subtitle-track","properties"]
  }
}
