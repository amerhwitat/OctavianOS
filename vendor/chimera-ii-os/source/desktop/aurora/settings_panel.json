  "policy": {
    "changes": "apply-immediately-when-safe",
    "privileged_changes": "request-Koronos-Aegis-policy",
    "page_visibility": "configurable"
  },
  "display_control": {
    "resolution_backends": [
      "kscreen-doctor",
      "wlr-randr",
      "xrandr"
    ],
    "persistent_state": "$XDG_CONFIG_HOME/chimera/display.conf",
    "driver_manager": "/usr/bin/chimera-gpu-driver-manager",
    "network_policy": "signed Ubuntu package repositories only"
  },
  "driver_hardware": {
    "entry": "/usr/bin/chimera-driver-panel.py",
    "automatic_detection": true,
    "audio_driver_manifest": "/usr/share/chimera/drivers/audio-driver-manifest.json",
    "hardware_catalog": "/usr/share/chimera/drivers/hardware-driver-catalog.json",
    "policy": "/usr/share/chimera/drivers/hardware-driver-policy.json"
  },
  "audio_drivers": {
    "page": "Sound",
    "manager": "/usr/bin/chimera-driver-panel.py",
    "manifest": "/usr/share/chimera/drivers/audio-driver-manifest.json",
    "automatic_detection": true
  }
}
