#version 450
layout(local_size_x=16, local_size_y=16) in;
layout(binding=0, rgba8) readonly uniform image2D src;
layout(binding=1, rgba8) writeonly uniform image2D dst;
const float kernel[5] = float[](0.227027,0.1945946,0.1216216,0.054054,0.016216);
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy); ivec2 size=imageSize(src); if(any(greaterThanEqual(p,size))) return;
    vec4 c=imageLoad(src,p)*kernel[0];
    for(int i=1;i<5;i++){ ivec2 q=clamp(p+ivec2(i,0),ivec2(0),size-1); ivec2 r=clamp(p-ivec2(i,0),ivec2(0),size-1); c+=(imageLoad(src,q)+imageLoad(src,r))*kernel[i]; }
    imageStore(dst,p,c);
}
