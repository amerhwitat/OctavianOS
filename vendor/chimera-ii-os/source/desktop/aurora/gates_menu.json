{
  "schema": "aurora-gates-menu-v3",
  "title": "Gates Menu",
  "background": {
    "image": "/usr/share/backgrounds/chimera/Aurora-Wayland-Glass-Desktop.png",
    "legacy_image": "/usr/share/chimera/aurora/aurora-wayland-glass.png",
    "source": "desktop/aurora/assets/aurora-wayland-glass.png",
    "mode": "cover",
    "fallback_color": "#08121e",
    "changeable": true,
    "configuration": "/etc/chimera/desktop-background.conf"
  },
  "categories": [
    {
      "id": "desktop",
      "label": "Desktop Environments / Personalities"
    },
    {
      "id": "applications",
      "label": "Applications"
    },
    {
      "id": "games",
      "label": "Games / Emulators / PlayStation"
    },
    {
      "id": "networking",
      "label": "Networking / Network Discovery / Route Manager"
    },
    {
      "id": "crypto",
      "label": "Crypto / Wallet Tools"
    },
    {
      "id": "thamudic",
      "label": "Thamudic / North Arabian"
    },
    {
      "id": "nlp",
      "label": "NLP"
    },
    {
      "id": "development",
      "label": "Development: C/C++/Java/Python/Kotlin/Node/WebAssembly"
    },
    {
      "id": "browsers",
      "label": "Web Browsers"
    },
    {
      "id": "system",
      "label": "System / Drivers / Filesystems / Security"
    },
    {
      "id": "installer",
      "label": "Chimera II Installer / Deployment"
    },
    {
      "id": "recovery",
      "label": "Recovery / Rescue / Rollback"
    },
    {
      "id": "boot",
      "label": "Boot / Koronos / Jasper / Spit Fire / GRUB2 / Gates"
    },
    {
      "id": "diagnostics",
      "label": "Hardware / Kernel / CPU Diagnostics"
    }
  ],
  "interaction": {
    "keyboard": true,
    "mouse": true,
    "double_click": true,
    "context_menu": true,
    "properties": true
  },
  "boot_contract": {
    "kernel": "Koronos (native target only when ELF and runtime are staged)",
    "native_bootloader": "Spit Fire",
    "boot_manager": "Jasper",
    "firmware_fallback": "GRUB2",
    "live_entry": "GRUB id aurora-live (native Koronos live target)",
    "installation_entry": "GRUB id install (native installer contract-gated)",
    "recovery_entry": "GRUB id recovery (dedicated native recovery menu)",
    "diagnostics_entry": "/boot/jasper/diagnostics.cfg",
    "vmlinuz": false,
    "koronos_entry": "GRUB id koronos (experimental native kernel diagnostics)",
    "display": "5120x2880 preferred; highest firmware-supported fallback; gfxpayload=keep",
    "logging": "verbose GRUB, kernel loglevel=7, ignore_loglevel, printk timestamps, systemd debug/status",
    "linux_live_edition": "separate Linux-kernel ISO boot path; default target id live-linux"
  },
  "actions": {
    "live": {
      "label": "Boot Live Aurora Desktop",
      "command": "grub-reboot aurora-live",
      "requires": "bootloader"
    },
    "install": {
      "label": "Native Koronos Installer (requires staged installer runtime)",
      "command": "grub-reboot install",
      "requires": "bootloader"
    },
    "recovery": {
      "label": "Linux Rescue Shell",
      "command": "grub-reboot recovery",
      "requires": "bootloader"
    },
    "diagnostics": {
      "label": "Diagnostics",
      "command": "grub-reboot diagnostics",
      "requires": "bootloader"
    },
    "jasper": {
      "label": "Jasper Unified Boot Manager",
      "command": "grub-reboot jasper",
      "requires": "bootloader"
    },
    "spitfire": {
      "label": "Spit Fire Firmware Adapter",
      "command": "grub-reboot spitfire",
      "requires": "bootloader"
    },
    "firmware": {
      "label": "UEFI Firmware Setup",
      "command": "systemctl reboot --firmware",
      "requires": "uefi"
    },
    "flash": {
      "label": "Aurora Flash Tool",
      "command": "aurora-flash-tool",
      "requires": "desktop"
    },
    "koronos": {
      "label": "Koronos Kernel Diagnostics (experimental)",
      "command": "grub-reboot koronos",
      "requires": "bootloader"
    },
    "native_recovery": {
      "label": "Native Koronos Recovery (requires staged recovery runtime)",
      "command": "grub-reboot recovery",
      "requires": "bootloader"
    }
  },
  "playstation_emulator_hub": {
    "label": "Aurora PlayStation Emulator Hub",
    "path": "/usr/share/chimera/web/playstation_emulators.html",
    "manifest": "/usr/share/chimera/web/playstation_emulators.json",
    "generations": [
      "PSX",
      "PS2",
      "PS3",
      "PS4",
      "PS5"
    ]
  },
  "boot_targets": {
    "menu": "/boot/jasper/live-image.cfg",
    "manifest": "/boot/boot-targets.json",
    "default": "live-linux",
    "fail_closed": true,
    "native_installer_requires": [
      "/boot/koronos/koronos.elf",
      "/boot/installer/installer-initrd.img",
      "/install/installer/installation.img",
      "/install/installer/installer-contract.json",
      "/install/installer/installation_phases.json",
      "/install/installer/installer_profiles.json"
    ],
    "native_recovery_requires": [
      "/boot/koronos/koronos.elf",
      "/boot/recovery/recovery-initramfs.img",
      "/boot/recovery/recovery-manifest.json"
    ]
  }
}
