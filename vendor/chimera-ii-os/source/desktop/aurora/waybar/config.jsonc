{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 8,
  "modules-left": ["custom/aurora", "wlr/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/package-managers", "network", "pulseaudio", "memory", "cpu", "battery", "tray"],
  "custom/aurora": {
    "format": "  CHIMERA II",
    "tooltip": true,
    "tooltip-format": "Aurora Wayland Desktop",
    "on-click": "sh -lc 'command -v wofi >/dev/null 2>&1 && wofi --show drun || true'"
  },
  "custom/package-managers": {
    "format": "󰏖 Packages",
    "tooltip": true,
    "tooltip-format": "Aurora Package Manager Center",
    "on-click": "python3 /usr/share/chimera/aurora/package_manager_panel.py"
  },
  "wlr/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "on-click": "activate",
    "sort-by-number": true
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
  },
  "network": {
    "format-wifi": " {essid} {signalStrength}%",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰖪 offline",
    "tooltip-format": "{ifname}: {ipaddr}"
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": "󰖁 muted",
    "on-click": "pavucontrol"
  },
  "cpu": { "format": "CPU {usage}%" },
  "memory": { "format": "RAM {percentage}%" },
  "battery": { "format": "BAT {capacity}%" },
  "tray": { "spacing": 8 }
}
