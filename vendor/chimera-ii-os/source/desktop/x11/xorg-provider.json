{
  "schema": "CHM-X11-PROVIDER-1",
  "provider": "X.Org Server / X11 compatibility session",
  "packages": [
    "xserver-xorg",
    "xinit",
    "xauth",
    "xwayland",
    "xvfb",
    "x11-xserver-utils",
    "x11-utils",
    "openbox"
  ],
  "commands": [
    "Xorg",
    "startx",
    "xinit",
    "Xwayland",
    "Xvfb",
    "openbox"
  ],
  "desktop_sessions": {
    "aurora": [
      "chimera-desktop-shell",
      "--desktop=aurora"
    ],
    "marine": [
      "chimera-desktop-shell",
      "--desktop=marine"
    ],
    "freexp": [
      "chimera-desktop-shell",
      "--desktop=freexp"
    ]
  },
  "status": "provider-declared-runtime-not-yet-verified",
  "runtime_prerequisites": [
    "Koronos Linux syscall ABI coverage for Xorg, GTK and GLib",
    "DRM/KMS graphics device support",
    "VT allocation and input device support",
    "device discovery and session/logind compatibility"
  ],
  "safety": "Do not make Xorg the default display server until all runtime prerequisites and both desktop sessions pass QEMU and hardware smoke tests."
}
