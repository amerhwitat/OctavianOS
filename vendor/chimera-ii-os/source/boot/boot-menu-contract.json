{
  "schema": "CHM-BOOT-MENU-4",
  "kernel": "Koronos",
  "primary_loader": "Spit Fire",
  "menu_manager": "Jasper",
  "firmware_menu": "Gates",
  "fallback_loader": "GRUB2",
  "installation_menu": "/boot/installation/menu.cfg",
  "entries": [
    "live",
    "safe-graphics",
    "install",
    "recovery",
    "diagnostics",
    "spitfire",
    "firmware",
    "reboot",
    "poweroff"
  ],
  "kernel_policy": {
    "live": "multiboot2 /boot/koronos/koronos.elf",
    "safe-graphics": "multiboot2 /boot/koronos/koronos.elf",
    "install": "multiboot2 /boot/koronos/koronos.elf",
    "recovery": "multiboot2 /boot/koronos/koronos.elf",
    "diagnostics": "multiboot2 /boot/koronos/koronos.elf"
  },
  "artwork_policy": {
    "canonical": "/boot/visual/aurora-wayland-glass.jpg",
    "desktop": "/usr/share/chimera/aurora/ChimeraIIOS-Aurora-Wayland-Glass.jpg",
    "fallback": "desktop/aurora/assets/aurora-desktop.svg"
  },
  "handoff": "Spit Fire -> Jasper/Gates -> Multiboot2/CHMBOOT1 -> Koronos -> hardware/driver discovery -> Aurora session",
  "linux_vmlinuz": false,
  "timeouts": {
    "primary_seconds": 300,
    "submenu_seconds": 120,
    "default_entry": "live",
    "policy": "Wait for user input for five minutes on primary boot menus and two minutes on nested menus, then select the configured default entry."
  }
}
