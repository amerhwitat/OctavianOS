{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amerhwitat/ChimeraIIOS/blob/main/data/ai/hardware_systems_knowledge.schema.json",
  "title": "Chimera Hardware Systems Knowledge Database",
  "type": "object",
  "required": [
    "schema",
    "version",
    "sources",
    "entries",
    "entry_count",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "CHIMERA-HARDWARE-SYSTEMS-KNOWLEDGE-1"
    },
    "version": {
      "type": "string"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "updated_utc": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "coverage_note": {
      "type": "string"
    },
    "policy": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "publisher",
          "title",
          "url",
          "kind",
          "authority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "title",
          "summary",
          "tags",
          "source_ids",
          "status",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
          },
          "domain": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "facts": {
            "type": "object"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          },
          "record_hash": {
            "type": "string"
          }
        }
      }
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
