{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "repositories": [
    {
      "id": "chimera-ii-os",
      "name": "Chimera II OS",
      "url": "https://github.com/amerhwitat/ChimeraIIOS",
      "role": "operating-system",
      "required": true
    },
    {
      "id": "bizx",
      "name": "BizX",
      "url": "https://github.com/amerhwitat/BizX",
      "role": "application-platform",
      "required": false
    },
    {
      "id": "bizxtreme",
      "name": "BizXtreme",
      "url": "https://github.com/amerhwitat/BizXtreme",
      "role": "game-application",
      "required": false
    },
    {
      "id": "general",
      "name": "General",
      "url": "https://github.com/amerhwitat/general",
      "role": "application-integration",
      "required": false
    },
    {
      "id": "nlp",
      "name": "NLP",
      "url": "https://github.com/amerhwitat/nlp",
      "role": "ancient-language-nlp",
      "required": false
    },
    {
      "id": "cpu4096",
      "name": "CPU4096",
      "url": "https://github.com/amerhwitat/CPU4096",
      "role": "processor-research",
      "required": false
    },
    {
      "id": "cpu4096-simulator",
      "name": "CPU4096Simulator",
      "url": "https://github.com/amerhwitat/CPU4096Simulator",
      "role": "processor-simulator",
      "required": false
    },
    {
      "id": "pdfreaderpy",
      "name": "PDFreaderPY",
      "url": "https://github.com/amerhwitat/PDFreaderPY",
      "role": "document-tool",
      "required": false
    },
    {
      "id": "eth-key-check",
      "name": "eth-key-check",
      "url": "https://github.com/amerhwitat/eth-key-check",
      "role": "crypto-utility",
      "required": false
    },
    {
      "id": "keygen",
      "name": "keygen",
      "url": "https://github.com/amerhwitat/keygen",
      "role": "crypto-utility",
      "required": false
    },
    {
      "id": "bruteforce",
      "name": "bruteforce",
      "url": "https://github.com/amerhwitat/bruteforce",
      "role": "research-utility",
      "required": false
    },
    {
      "id": "test",
      "name": "test",
      "url": "https://github.com/amerhwitat/test",
      "role": "test-workspace",
      "required": false
    }
  ],
  "build_policy": {
    "compilers": [
      "gnu",
      "msvc"
    ],
    "parallel": true,
    "continue_on_failure": true,
    "stage_executables": true,
    "stage_libraries": true,
    "stage_boot_images": true,
    "preserve_source_tree": true,
    "preserve_provenance": true,
    "pin_revision": true,
    "license_check": true
  }
}
