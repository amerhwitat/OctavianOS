  },
  "backends": {
    "static_routes": [
      "iproute2",
      "Spotnik RIB/FIB ABI"
    ],
    "dynamic_routing": [
      "FRRouting vtysh adapter"
    ],
    "eigrp": "experimental-adapter-only",
    "policy": "Protocol is operational only when daemon/backend and conformance tests are installed; catalog entry alone is not proof of implementation."
  },
  "safety": {
    "shell_execution": false,
    "default_mode": "plan-only",
    "mutation_requires": [
      "--apply",
      "exact confirmation phrase",
      "administrator/root privileges"
    ],
    "unknown_commands": "reject",
    "dynamic_peer_establishment": "disabled until explicitly configured"
  }
}
