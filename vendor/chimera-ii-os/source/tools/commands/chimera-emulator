#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="${CHIMERA_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
MANAGER="$ROOT/tools/emulation/chimera-emulator-manager.ps1"
if ! command -v pwsh >/dev/null 2>&1; then
  echo "chimera-emulator: PowerShell (pwsh) is required for catalog queries" >&2
  exit 127
fi
exec pwsh -NoProfile -File "$MANAGER" "$@"
