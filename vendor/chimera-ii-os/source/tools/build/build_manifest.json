{
  "schema": "CHM-BUILD-MANIFEST-1",
  "version": 1,
  "project": "ChimeraIIOS",
  "native": {
    "configure": "cmake",
    "build": "cmake --build",
    "test": "ctest",
    "package": "cpack"
  },
  "languages": {
    "python": {"probe": "python", "deps": "pip", "build": "python", "test": "python"},
    "rust": {"probe": "cargo", "deps": "cargo", "build": "cargo", "test": "cargo"},
    "node": {"probe": "node", "deps": "npm", "build": "npm", "test": "npm"},
    "java": {"probe": "java", "deps": "maven-or-gradle", "build": "maven-or-gradle", "test": "maven-or-gradle"},
    "dotnet": {"probe": "dotnet", "deps": "dotnet", "build": "dotnet", "test": "dotnet"},
    "kotlin": {"probe": "kotlinc", "deps": "gradle", "build": "gradle", "test": "gradle"},
    "swift": {"probe": "swift", "deps": "swiftpm", "build": "swift", "test": "swift"},
    "dart": {"probe": "dart", "deps": "dart", "build": "dart", "test": "dart"},
    "asm": {"probe": "nasm", "deps": "package-manager", "build": "nasm", "test": "native"}
  },
  "safety": {
    "download_allowlist_required": true,
