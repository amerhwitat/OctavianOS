#!/usr/bin/env bash
set -euo pipefail
assembler="${CHIMERA_ASSEMBLER:-gnu}"
case "$assembler" in
  gnu) exec as "$@" ;;
  llvm) exec llvm-mc -filetype=obj "$@" ;;
  nasm) exec nasm "$@" ;;
  chimera) echo "chimera-as is the native Chimera ISA assembler; invoke it directly." >&2; exec chimera-as "$@" ;;
  *) echo "chimera-gas: CHIMERA_ASSEMBLER must be gnu, llvm, nasm, or chimera" >&2; exit 2 ;;
esac
