{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Chimera II Command Compatibility Registry",
  "type":"object",
  "required":["schema","schema_version","resolution_order","commands"],
  "properties":{
    "schema":{"const":"chimera-ii-command-registry"},
    "schema_version":{"const":1},
    "generated":{"type":"boolean"},
    "host":{"type":"object"},
    "resolution_order":{"type":"array","items":{"type":"string"}},
    "sources":{"type":"string"},
    "commands":{"type":"array","items":{"type":"object","required":["name","availability","kind"],"properties":{"name":{"type":"string"},"availability":{"type":"array","items":{"type":"string"}},"kind":{"type":"string"}},"additionalProperties":true}}
  },
  "additionalProperties":false
}
