[Version]
Signature="$WINDOWS NT$"
Class=Sample
ClassGuid={78A1C341-4539-11D3-B88D-00C04FAD5171}
Provider=%ProviderName%
DriverVer=09/08/2026,1.0.0.0

[Manufacturer]
%MfgName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=Install,Root\ChimeraKMDFEcho

[Install]
CopyFiles=DriverCopy

[DriverCopy]
KMDF_ChmEcho.sys

[Install.Services]
AddService=KMDF_ChmEcho,0x00000002,Service

[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\KMDF_ChmEcho.sys

[Strings]
ProviderName="Chimera II OS"
MfgName="Chimera II OS"
DeviceName="Chimera II KMDF Echo"
ServiceName="Chimera II KMDF Echo"
