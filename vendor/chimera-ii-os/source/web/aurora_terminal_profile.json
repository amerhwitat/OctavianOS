{
  "schema":"chimera-aurora-terminal/v1",
  "theme":"aurora-glass",
  "font":"JetBrains Mono",
  "font_fallback":["Cascadia Code","Fira Code","monospace"],
  "background":"rgba(3,7,15,.70)",
  "foreground":"#eaf4ff",
  "prompt":"aurora@chimera:~$",
