				<div class="elementor-element elementor-element-d9e4558 e-flex e-con-boxed e-con e-parent" data-id="d9e4558" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;video&quot;,&quot;background_video_link&quot;:&quot;https:\/\/mips.com\/wp-content\/uploads\/2026\/09\/MIPS_MainComp_SNIPPET_V005_.mp4&quot;,&quot;background_play_on_mobile&quot;:&quot;yes&quot;}">
