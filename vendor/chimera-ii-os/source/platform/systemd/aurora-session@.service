[Unit]
Description=Aurora Wayland Desktop Session for %i
Documentation=https://github.com/amerhwitat/ChimeraIIOS
Requires=chimera-kernel.service
After=chimera-kernel.service

[Service]
Type=simple
User=%i
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=Aurora
Environment=XDG_SESSION_DESKTOP=aurora
Environment=MOZ_ENABLE_WAYLAND=1
Environment=QT_QPA_PLATFORM=wayland
ExecStart=/usr/lib/chimera/aurora-session
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
