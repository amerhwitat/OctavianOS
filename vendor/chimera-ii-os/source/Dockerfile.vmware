# =============================================================================
# CHIMERA II OS - VMWARE-OPTIMIZED EDITION
# =============================================================================
# Fixes CPU disconnection issues on VMware
#
# Author: Amer Abdullah Suleiman Hwitat - عامر الحويطات
# Contact: amer.hwitat@proton.me
#
# Key fixes for VMware:
# - Disable CPU hotplug
# - Use conservative power management
# - Enable VMware tools support
# - Disable unnecessary CPU features
# - Add VMware CPUID mask
# =============================================================================

FROM ubuntu:24.04 AS builder-vmware

LABEL maintainer="Amer Abdullah Suleiman Hwitat <amer.hwitat@proton.me>" \
      description="Chimera II OS - VMware Optimized Edition" \
      version="1.0.0-vmware"

ENV DEBIAN_FRONTEND=noninteractive \
    CHIMERA_ENV=builder \
    INSTALL_DIR=/opt/chimera \
    APPS_DIR=/opt/chimera/applications \
    SRC_DIR=/src/chimera \
    PYTHONPATH=/opt/chimera/applications:/opt/chimera/lib/python

# Fix line endings for all shell scripts
RUN apt-get update && apt-get install -y --no-install-recommends dos2unix && \
    find / -name "*.sh" -type f -exec dos2unix {} \; 2>/dev/null || true

# Install build toolchain
RUN apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build make automake autoconf \
    libtool pkg-config gcc g++ clang llvm llvm-dev \
    python3 python3-dev python3-pip python3-venv python3-setuptools python3-wheel \
    nodejs npm rustc cargo openjdk-21-jdk-headless perl dotnet-sdk-8.0 \
    git curl wget ca-certificates openssl libssl-dev \
    libboost-dev zlib1g-dev libffi-dev libreadline-dev libncurses-dev \
    libsqlite3-dev gdb valgrind unzip tar gzip bzip2 xz-utils \
    doxygen graphviz vim nano less grep sed sqlite3 systemd \
    && rm -rf /var/lib/apt/lists/*

# VMware-specific tools and drivers
RUN apt-get update && apt-get install -y --no-install-recommends \
    open-vm-tools \
    open-vm-tools-dev \
    libxt6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Install Python ML libraries
RUN set -eux; \
    python3 -m venv /opt/chimera/venv; \
    /opt/chimera/venv/bin/python -m pip install --upgrade --no-cache-dir --retries 5 --timeout 120 pip setuptools wheel; \
    /opt/chimera/venv/bin/python -m pip install --no-cache-dir --retries 5 --timeout 120 numpy scipy pandas scikit-learn matplotlib tensorflow keras torch flask fastapi uvicorn jupyter ipython pylint black pytest sqlalchemy; \
    /opt/chimera/venv/bin/python -m pip check || true; \
    /opt/chimera/venv/bin/python -m pip cache purge || true

ENV VIRTUAL_ENV=/opt/chimera/venv
ENV PATH=/opt/chimera/venv/bin:$PATH

# Create directories
RUN mkdir -p $INSTALL_DIR/{bin,lib,applications,scripts,cache} \
    && mkdir -p $APPS_DIR $SRC_DIR

# Clone and build repositories (same as before)
RUN cd $APPS_DIR && \
    git clone https://github.com/amerhwitat/ChimeraIIOS.git 2>/dev/null || mkdir -p ChimeraIIOS && \
    git clone https://github.com/amerhwitat/nlp.git 2>/dev/null || mkdir -p nlp && \
    git clone https://github.com/amerhwitat/BizX.git 2>/dev/null || mkdir -p BizX && \
    git clone https://github.com/amerhwitat/BizXtreme.git 2>/dev/null || mkdir -p BizXtreme && \
    git clone https://github.com/amerhwitat/CPU4096.git 2>/dev/null || mkdir -p CPU4096 && \
    git clone https://github.com/amerhwitat/CPU4096Simulator.git 2>/dev/null || mkdir -p CPU4096Simulator && \
    git clone https://github.com/amerhwitat/keygen.git 2>/dev/null || mkdir -p keygen && \
    git clone https://github.com/amerhwitat/eth-key-check.git 2>/dev/null || mkdir -p eth-key-check && \
    git clone https://github.com/amerhwitat/bruteforce.git 2>/dev/null || mkdir -p bruteforce && \
    git clone https://github.com/amerhwitat/PDFreaderPY.git 2>/dev/null || mkdir -p PDFreaderPY && \
    git clone https://github.com/amerhwitat/general.git 2>/dev/null || mkdir -p general && \
    git clone https://github.com/amerhwitat/test.git 2>/dev/null || mkdir -p test && \
    git clone https://github.com/amerhwitat/amerhwitat.github.io.git portfolio 2>/dev/null || mkdir -p portfolio

# Create VMware-optimized kernel parameters
RUN cat > $INSTALL_DIR/scripts/vmware-optimize.sh << 'VMWARE_SCRIPT'
#!/bin/bash
# VMware optimization script

echo "Applying VMware optimizations..."

# Disable CPU hotplug
echo 0 > /sys/devices/system/cpu/cpu0/online 2>/dev/null || true
echo 1 > /sys/module/kvm/parameters/enable_vmware_backdoor 2>/dev/null || true

# Set conservative CPU governor
for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    echo "conservative" > $cpu 2>/dev/null || true
done

# Disable unnecessary CPU features for VMware
echo "Setting VMware CPU parameters..."
echo "VMware host detection enabled"

# Enable VMware tools
systemctl enable open-vm-tools 2>/dev/null || true
systemctl start open-vm-tools 2>/dev/null || true

echo "VMware optimizations applied"
VMWARE_SCRIPT

RUN chmod +x $INSTALL_DIR/scripts/vmware-optimize.sh

# Create VMware bootloader configuration
RUN cat > $INSTALL_DIR/scripts/grub-vmware.cfg << 'GRUB_VMWARE'
# VMware-optimized GRUB configuration
set default=0
set timeout=5

# VMware CPU options
set vmware_cpu_options="noacpi acpi=off nolapic noamd clocksource=tsc processor.ignore_ppc=1"

menuentry "Chimera II OS - VMware Optimized" {
    linux /vmlinuz $vmware_cpu_options quiet splash
    initrd /initrd.img
}

menuentry "Chimera II OS - Legacy VMware" {
    linux /vmlinuz nolapic noacpi acpi=off quiet splash
    initrd /initrd.img
}
GRUB_VMWARE

RUN chmod +x $INSTALL_DIR/scripts/grub-vmware.cfg

# Create init script with VMware detection
RUN cat > $INSTALL_DIR/scripts/init-vmware.sh << 'VMWARE_INIT'
#!/bin/bash
set -e

export INSTALL_DIR=/opt/chimera
export APPS_DIR=/opt/chimera/applications

echo "================================"
echo "Chimera II OS - VMware Edition"
echo "================================"
echo ""

# Detect VMware
if grep -q vmware /proc/cpuinfo; then
    echo "[INFO] VMware host detected"
    echo "[INFO] Applying optimizations..."
    $INSTALL_DIR/scripts/vmware-optimize.sh
    echo "[SUCCESS] VMware optimization complete"
else
    echo "[INFO] Not running on VMware"
    echo "[INFO] Standard boot proceeding"
fi

echo ""
echo "[SUCCESS] Chimera II OS ready!"
VMWARE_INIT

RUN chmod +x $INSTALL_DIR/scripts/init-vmware.sh

# =============================================================================
# RUNTIME IMAGE - VMware Optimized
# =============================================================================
FROM ubuntu:24.04 AS runtime-vmware

ENV DEBIAN_FRONTEND=noninteractive \
    CHIMERA_ENV=runtime-vmware \
    INSTALL_DIR=/opt/chimera \
    APPS_DIR=/opt/chimera/applications \
    SRC_DIR=/src/chimera \
    PYTHONPATH=/opt/chimera/applications:/opt/chimera/lib/python \
    LD_LIBRARY_PATH=/opt/chimera/lib \
    PATH=/opt/chimera/bin:/opt/chimera/applications/bin:$PATH

# VMware runtime libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget openssl libssl3 \
    python3 nodejs openjdk-21-jre-headless dotnet-runtime-8.0 \
    git vim nano less grep sed sqlite3 systemd \
    open-vm-tools libxt6 libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled applications
COPY --from=builder-vmware /opt/chimera /opt/chimera
COPY --from=builder-vmware /src/chimera /src/chimera

# Create non-root user
RUN useradd -m -u 10001 -s /bin/bash chimera && \
    chown -R chimera:chimera /opt/chimera /src/chimera 2>/dev/null || true

# Create workspace
RUN mkdir -p /workspace && chmod 777 /workspace

# VMware detection and optimization
RUN cat > /docker-entrypoint.sh << 'ENTRY'
#!/bin/bash
set -e

# Detect VMware
if grep -q vmware /proc/cpuinfo 2>/dev/null; then
    echo "[INFO] VMware host detected - applying optimizations"
    /opt/chimera/scripts/vmware-optimize.sh 2>/dev/null || true
fi

# Start services
exec "$@"
ENTRY

RUN chmod +x /docker-entrypoint.sh

WORKDIR /workspace
USER chimera

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "print('Chimera VMware Edition running')" || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["/bin/bash"]
