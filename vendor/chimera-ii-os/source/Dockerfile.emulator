FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends qemu-system-x86 qemu-system-arm qemu-system-misc qemu-utils ovmf bash ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/chimera
COPY . /opt/chimera
RUN chmod +x /opt/chimera/tools/hosted/*.sh
ENTRYPOINT ["/opt/chimera/tools/hosted/chimera-host-run.sh"]
