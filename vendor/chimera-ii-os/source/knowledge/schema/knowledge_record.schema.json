{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Chimera Knowledge Record",
  "type":"object",
  "required":["id","source","retrieved_at","subject","content_hash","classification","content"],
  "properties":{
    "id":{"type":"string"},"source":{"type":"string","format":"uri"},"retrieved_at":{"type":"string","format":"date-time"},
    "subject":{"type":"array","items":{"type":"string"}},"language":{"type":"string"},
    "classification":{"enum":["fact","documentation","research","software","security","news","reference","unknown"]},
    "content_hash":{"type":"string"},"canonical_hash":{"type":"string"},"content":{"type":"string"},
    "embedding":{"type":"array","items":{"type":"number"}},"links":{"type":"array","items":{"type":"string","format":"uri"}},
    "confidence":{"type":"number","minimum":0,"maximum":1},"license":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}}
  }
}