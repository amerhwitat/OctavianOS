        "fit": "cover",
        "overlay": "aurora-glass",
        "transition": "fade"
      }
    },
    {
      "id": "identity-security",
      "order": 60,
      "name": "Identity and security",
      "actions": [
        "initialize /etc/passwd /etc/shadow /etc/group /etc/gshadow",
        "create UID 0 root account",
        "prompt for root password",
        "install filesystem security policy",
        "optionally stage SSSD/winbind/Kerberos AD configuration"
      ],
      "requires_root": true,
      "reboot": false,
      "background": {
        "default": "/boot/jasper/background.png",
        "fit": "cover",
        "overlay": "aurora-glass",
        "transition": "fade"
      }
