  "profiles": [
    "minimal",
    "desktop",
    "developer",
    "security-lab",
    "forensics",
    "reverse-engineering",
    "server",
    "mobile-hosted",
    "mobile-baremetal",
    "emulator",
    "full"
  ],
  "safety": {
    "destructive_operations_require_confirmation": true,
    "partition_changes_require_confirmation": true,
    "baremetal_flash_requires_device_profile": true,
    "locked_bootloader_is_not_bypassed": true,
    "secure_boot_is_not_bypassed": true,
    "recovery_media_recommended": true
  },
  "backgrounds": {
    "schema": "CHM-INSTALL-BACKGROUNDS-1",
    "default": "/install/installer-background.png",
    "source": "desktop/aurora/assets and boot/splash",
    "fallback": "/install/installer-background.png"
  }
