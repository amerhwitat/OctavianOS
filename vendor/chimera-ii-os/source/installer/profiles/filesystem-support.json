{
  "schema": "CHM-FILESYSTEMS-2",
  "native": "qfs",
  "native_block_policy": {
    "default_bytes": 4096,
    "allowed_bytes": [
      4096,
      8192,
      16384,
      32768,
      65536
    ],
    "minimum_bytes": 4096,
    "maximum_bytes": 65536,
    "require_kernel_page_size_at_least_block": true,
    "sector_default_bytes": 512
  },
  "installable": [
    "qfs",
    "ext4",
    "xfs",
    "btrfs",
    "zfs",
    "ntfs3",
    "vfat",
    "exfat"
  ],
  "boot_media": [
    "iso9660",
    "udf",
    "squashfs",
    "vfat",
    "fat32"
  ],
  "network_filesystems": [
    "nfs",
    "nfs4",
    "cifs",
    "sshfs",
    "smb3"
  ],
  "compatibility": [
    "fuse",
    "overlayfs"
  ],
  "operations": [
    "probe",
    "format",
    "check",
    "mount",
    "unmount",
    "resize",
    "snapshot",
    "rollback",
    "mount-iso",
    "mount-optical",
    "eject",
    "browse-smb",
    "discover-windows-network",
    "join-active-directory",
    "ldap-search",
    "provision-fhs"
  ],
  "encryption": [
    "luks2"
  ],
  "volume_management": [
    "lvm2",
    "mdraid",
    "zfs-pools",
    "btrfs-subvolumes"
  ],
  "policy": "QFS is the native Chimera target. Backend availability is detected at installer runtime; unsupported tools are reported rather than silently selected.",
  "optical_media": {
    "filesystems": [
      "iso9660",
      "udf"
    ],
    "devices": [
      "/dev/sr0",
      "/dev/sr1"
    ],
    "mount_root": "/mnt/chimera/media",
    "default_options": [
      "ro",
      "nodev",
      "nosuid",
      "noexec"
    ],
    "image_loop_mount": true,
    "auto_run": false
  },
  "directory_services": {
    "smb": {
      "client": [
        "smbclient",
        "cifs-utils"
      ],
      "server": [
        "samba"
      ],
      "minimum_protocol": "SMB2",
      "maximum_protocol": "SMB3",
      "guest_access_default": false
    },
    "windows_discovery": [
      "wsdd",
      "avahi-dns-sd"
    ],
    "active_directory": {
      "join": [
        "realmd",
        "adcli"
      ],
      "identity": [
        "sssd-ad",
        "sssd"
      ],
      "authentication": [
        "kerberos"
      ],
      "automatic_join": false
    },
    "ldap": {
      "tools": [
        "ldap-utils"
      ],
      "tls_default": "ldaps",
      "certificate_validation": true,
      "plaintext_default": false
    }
  },
  "linux_fhs": {
    "provisioner": "tools/storage/chimera-init-layout.sh",
    "pseudo_filesystems": [
      "/proc",
      "/sys",
      "/dev"
    ],
    "mountpoints": [
      "/mnt",
      "/media",
      "/mnt/chimera/media",
      "/mnt/chimera/network"
    ]
  }
}
