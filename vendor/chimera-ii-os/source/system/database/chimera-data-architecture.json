{
  "name": "Chimera Data Architecture",
  "version": "2.0",
  "model": [
    "ER",
    "MDM",
    "OLTP",
    "OLAP",
    "HTAP"
  ],
  "design": {
    "transaction_engine": "MVCC + WAL + two-phase commit boundary",
    "analytics_engine": "columnar/vectorized execution + partition pruning",
    "semantic_layer": "MDM canonical entities, identity resolution, survivorship rules",
    "integration": [
      "SQL",
      "REST",
      "JDBC",
      "ODBC",
      "CDC",
      "Kafka-compatible event streams"
    ],
    "storage": [
      "row",
      "column",
      "object",
      "LSM"
    ],
    "deployment": [
      "single-node",
      "cluster",
      "NUMA",
      "distributed"
    ]
  },
  "reference_profiles": [
    {
      "name": "Oracle-style enterprise profile",
      "features": [
        "partitioning",
        "parallel query",
        "MVCC",
        "materialized views",
        "CDC"
      ]
    },
    {
      "name": "SAP-HANA-style in-memory profile",
      "features": [
        "column store",
        "vectorized execution",
        "in-memory OLAP",
        "HTAP"
      ]
    },
    {
      "name": "Chimera native profile",
      "features": [
        "RegisterN vectors",
        "zero-copy IPC",
        "Koronos scheduling",
        "Nucleus integration"
      ]
    },
    {
      "name": "SQL Server/T-SQL compatibility profile",
      "features": [
        "T-SQL parser",
        "stored procedures",
        "transactions",
        "window functions",
        "SQL Server-style metadata adapter"
      ]
    },
    {
      "name": "Oracle PL/SQL compatibility profile",
      "features": [
        "PL/SQL parser",
        "packages",
        "procedures",
        "functions",
        "triggers",
        "exception handling",
        "Oracle-style metadata adapter"
      ]
    }
  ],
  "entities": [
    "Party",
    "Organization",
    "Account",
    "Asset",
    "Product",
    "Location",
    "Event",
    "Document",
    "Device",
    "User",
    "Role",
    "Permission"
  ],
  "mdm": [
