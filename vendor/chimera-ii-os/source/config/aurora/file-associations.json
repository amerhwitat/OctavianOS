    {"match":{"mime":"video/*"},"handler":"aurora.media","verb":"open"},
    {"match":{"mime":"application/pdf"},"handler":"aurora.document","verb":"open"},
    {"match":{"extension":".exe"},"handler":"compat.pe","verb":"run"},
    {"match":{"extension":".com"},"handler":"compat.dos","verb":"run"},
    {"match":{"extension":".bat"},"handler":"compat.dos","verb":"run"},
    {"match":{"extension":".cmd"},"handler":"compat.dos","verb":"run"}
  ]
}
