{
  "schema": 1,
  "abi": "CHIMERA_PLATFORM_FEATURE_ABI",
  "implementation": "native",
  "feature_groups": {
    "kernel": ["objects", "processes", "threads", "vmem", "pagecache", "vfs", "block_io", "dma_iommu", "pnp", "hotplug", "network", "security", "tpm", "graphics", "input", "audio", "power", "virtualization", "diagnostics"],
