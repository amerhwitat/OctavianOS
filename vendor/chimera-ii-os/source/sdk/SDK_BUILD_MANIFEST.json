{
  "schema": "CHM-SDK-BUILD-1",
  "version": "1.0.0",
  "targets": [
    "chimera-x86_64",
    "chimera-aarch64",
    "chimera-riscv64"
  ],
  "languages": [
    "C",
    "C++",
    "C#",
    "Objective-C",
    "Java",
    "Python",
    "Rust",
    "Zig",
    "Go",
    "Fortran",
    "Swift",
    "Assembly"
  ],
  "artifacts": [
    "native-library",
    "sdk-config",
    "python-package",
    "csharp-project",
    "objective-c-source",
    "java-source",
    "java-jar",
    "examples",
    "manuals",
    "rust-static-library",
    "rust-cdylib",
    "optional-toolchain-smoke-artifacts",
    "toolchain-smoke-status"
  ],
  "iso_destination": "/opt/chimera-sdk",
  "source_destination": "/opt/chimera-sdk/source",
  "optional_toolchains": {
    "build_policy": "Compile a smoke artifact when the upstream compiler is installed; record SKIP otherwise; never download compilers during ISO builds.",
    "languages": [
      "Assembly",
      "Objective-C",
      "Zig",
      "Go",
      "Fortran",
      "Swift"
    ]
  }
}
