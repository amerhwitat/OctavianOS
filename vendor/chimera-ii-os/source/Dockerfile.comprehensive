echo "[SUCCESS] Chimera II OS ready!"
INIT_SCRIPT
RUN chmod +x $INSTALL_DIR/scripts/init-chimera.sh

# =============================================================================
# RUNTIME IMAGE
# =============================================================================
FROM builder AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    CHIMERA_ENV=runtime \
    INSTALL_DIR=/opt/chimera \
    APPS_DIR=/opt/chimera/applications \
    SRC_DIR=/src/chimera

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip \
    nodejs npm \
    openjdk-21-jre-headless \
    git curl wget \
    libssl3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 10001 chimera && \
    mkdir -p /workspace && \
    chown -R chimera:chimera /workspace

# Keep the exported runtime image deterministic and free of host/package-manager
# state that has no value inside an immutable Chimera ISO.
RUN set -eux; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/* /var/log/.* 2>/dev/null || true; \
    rm -rf /var/tmp/* /tmp/* /run/* /root/.cache/*; \
    find /opt/chimera /src/chimera -type d -name .git -prune -exec rm -rf {} + 2>/dev/null || true; \
    find /opt/chimera /src/chimera -type d \( -name __pycache__ -o -name .pytest_cache -o -name .mypy_cache \) -prune -exec rm -rf {} + 2>/dev/null || true; \
    mkdir -p /var/log /var/tmp /tmp /run; \
    chmod 1777 /tmp /var/tmp

WORKDIR /workspace

EXPOSE 8000 8080 9000 9001 5000 3000

ENTRYPOINT ["/bin/bash", "/opt/chimera/scripts/init-chimera.sh"]
CMD ["/bin/bash"]

