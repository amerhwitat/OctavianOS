  "interrupt_boundary": {
    "kernel_header": "kernel/include/chimera/interrupt.h",
    "x86_vectors": {
      "exceptions": "0-31; kernel-owned",
      "hardware_irqs": "32-255 subject to controller/APIC routing",
      "native_syscall_vector": "0x80 metadata/compatibility path; ring-3 DPL is not enabled by current IDT setup",
      "windows_nt_syscall_vector": "0x2e historical compatibility identity only",
      "dos_compat_vector": "0x21 compatibility/emulation identity only"
    },
    "application_policy": "Applications receive validated events/IPC, never raw hardware interrupt ownership. Do not treat vector recognition as a complete syscall ABI."
  },
  "objective_c_driver": {
    "command": "sdk/bin/chimera-objc",
    "compiler": "Clang Objective-C frontend",
    "targets": [
      "native",
      "darwin-x86_64",
      "darwin-arm64"
    ],
    "macos_link_requires": "CHIMERA_MACOS_SDK pointing to a matching SDK",
    "status": "syntax/object compilation supported subject to installed Clang; full macOS app linking requires SDK/runtime/frameworks"
  }
}
