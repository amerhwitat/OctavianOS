  "programming_models": {
    "windows_event_driven": {
      "style": "message-loop, handles, callbacks, overlapped IO",
      "sdk_header": "sdk/include/chimera/win32_message.h",
      "sdk_status": "implemented user-space message queue adapter; no full Win32 GUI/kernel ABI",
      "api_families": {
        "kernel32": [
          "CreateProcess",
          "CreateThread",
          "CreateEvent",
          "SetEvent",
          "WaitForSingleObject",
          "WaitForMultipleObjects",
          "CreateFile",
          "ReadFile",
          "WriteFile",
          "CloseHandle",
          "VirtualAlloc",
          "VirtualFree"
        ],
        "user32": [
          "GetMessage",
          "PeekMessage",
          "TranslateMessage",
          "DispatchMessage",
          "PostMessage",
          "SendMessage",
          "DefWindowProc",
          "CreateWindowEx",
          "DestroyWindow"
        ],
        "gdi32": [
          "BeginPaint",
          "EndPaint",
          "TextOut",
          "BitBlt"
        ],
        "ws2_32": [
          "socket",
          "bind",
          "connect",
          "listen",
          "accept",
          "send",
          "recv",
          "WSAWaitForMultipleEvents",
          "IOCP"
        ],
        "ntdll": [
          "NtCreateFile",
          "NtReadFile",
          "NtWriteFile",
          "NtWaitForSingleObject",
          "NtCreateSection"
        ],
        "status": "catalogued; full API implementation not claimed",
        "user32_status": "implemented subset: PostMessage-shaped posting, GetMessage-shaped retrieval, DispatchMessage-shaped callback; CreateWindowEx/DefWindowProc/real HWND backend pending"
      }
    },
    "linux_posix_file_oriented": {
      "style": "file descriptors, streams, poll/epoll, signals, processes",
      "sdk_header": "sdk/include/chimera/file.h",
      "sdk_status": "hosted-posix-adapter; native kernel VFS binding pending",
      "api_families": {
        "file": [
          "open",
          "close",
