    "macos_darwin": {
      "style": "POSIX descriptors plus Darwin/Mach services and Objective-C frameworks",
      "sdk_header": "sdk/include/chimera/file.h",
      "sdk_status": "hosted-posix-adapter; Darwin ABI translation/frameworks pending",
      "api_families": {
        "posix": [
