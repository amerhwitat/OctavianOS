{
  "schema": "chimera-binary-format-registry-v2",
  "formats": [
    {
      "name": "ELF",
      "extensions": [
        ".elf"
      ],
      "loader": "native-or-qemu-user"
    },
    {
      "name": "PE/COFF",
      "extensions": [
        ".exe",
        ".dll",
        ".sys"
      ],
      "loader": "wine"
    },
    {
      "name": "DOS MZ",
      "extensions": [
        ".com",
        ".exe"
      ],
      "loader": "dosbox"
    },
    {
      "name": "PE32+ EFI",
      "extensions": [
        ".efi"
      ],
      "loader": "uefi"
    },
    {
      "name": "Mach-O",
      "extensions": [
        ".dylib",
        ".bundle"
      ],
      "loader": "darling"
    },
    {
      "name": "WebAssembly",
      "extensions": [
        ".wasm"
      ],
      "loader": "wasmtime-or-wasmer"
    },
    {
      "name": "Java",
      "extensions": [
        ".class",
        ".jar"
      ],
      "loader": "jvm"
    },
    {
      "name": ".NET",
      "extensions": [
        ".dll",
        ".exe"
      ],
      "loader": "dotnet-runtime"
    },
    {
      "name": "script",
      "extensions": [
        ".py",
        ".pl",
        ".sh",
        ".bash",
        ".bat",
        ".ps1",
        ".js",
        ".mjs"
      ],
      "loader": "interpreter-registry"
    }
  ],
  "policy": "Format recognition is not an assertion that a foreign binary is safe, licensed or executable on every target.",
  "runtime_selection": {
    "header_inspector": "tools/inspect-binary-headers.py",
    "recursive_scanner": "tools/binary/scan-binaries.py",
    "launcher": "tools/binary/run-compat.py",
    "dry_run_default": true,
    "execute_only_when_explicit": true,
    "foreign_runtime_candidates": {
      "ELF": [
        "qemu-user"
      ],
      "PE/COFF": [
        "wine"
      ],
      "Mach-O": [
        "darling"
      ],
      "DOS MZ": [
        "dosbox"
      ],
      "WebAssembly": [
        "wasmtime",
        "wasmer"
      ]
    },
    "package_source_policy": "Install through the host distribution or official upstream package manager; do not mirror unverified or proprietary binary archives."
  }
}
