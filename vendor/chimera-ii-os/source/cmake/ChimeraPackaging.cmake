set(CPACK_PACKAGE_NAME "ChimeraIIOS")
set(CPACK_PACKAGE_VENDOR "Chimera II OS Project")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Chimera II OS host runtime and development components")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_CONTACT "Chimera II OS maintainers")
set(CPACK_PACKAGE_CHECKSUM "SHA256")
set(CPACK_PACKAGE_FILE_NAME "ChimeraIIOS-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_GENERATOR "TGZ;ZIP")
if(WIN32)
  list(APPEND CPACK_GENERATOR "NSIS")
  set(CPACK_NSIS_DISPLAY_NAME "Chimera II OS")
  set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
  set(CPACK_NSIS_MODIFY_PATH OFF)
endif()
if(UNIX AND NOT APPLE)
  list(APPEND CPACK_GENERATOR "DEB;RPM")
  set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Chimera II OS maintainers")
  set(CPACK_RPM_PACKAGE_LICENSE "Open source; see repository licenses")
endif()
if(APPLE)
  list(APPEND CPACK_GENERATOR "DragNDrop")
endif()
include(CPack)
