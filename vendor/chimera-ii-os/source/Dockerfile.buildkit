FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git cmake ninja-build build-essential qemu-user-static qemu-system-x86 qemu-utils bash python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . /src
CMD ["bash","tools/build-full-iso.sh"]
