extern "C" int chimera_process_admit_elf(const void*image,uint64_t size,uint16_t machine,uint64_t stack,chimera_process_image*out){if(!image||!out||stack<PAGE)return -1;const auto*h=(const koronos_elf64_ehdr*)image;if(size<sizeof(koronos_elf64_ehdr))return -2;if(!koronos_elf64_valid(h))return -2;if(h->e_machine!=machine)return -2;const auto*ph=(const koronos_elf64_phdr*)((const uint8_t*)image+h->e_phoff);chimera_process_image p{};p.entry=h->e_entry;p.user_stack_top=down(stack);uint32_t n=0;uint64_t low=UINT64_MAX,high=0;for(uint16_t i=0;i<h->e_phnum;i++){const auto&s=ph[i];if(s.p_type!=PT_LOAD)continue;if(s.p_memsz<s.p_filesz||!in(s.p_offset,s.p_filesz,size))return -3;uint64_t end=0;if(!add_ok(s.p_vaddr,s.p_memsz,&end)||s.p_memsz==0||s.p_vaddr>=stack||end>stack)return -4;if(s.p_align&&(s.p_align&(s.p_align-1)))return -5;if(n>=MAX_SEGMENTS)return -6;if((s.p_flags&(PF_W|PF_X))==(PF_W|PF_X))return -7;auto&d=p.segments[n++];d.file_offset=s.p_offset;d.virtual_address=down(s.p_vaddr);d.file_size=s.p_filesz;d.memory_size=s.p_memsz+(s.p_vaddr-d.virtual_address);d.flags=s.p_flags;d.align=s.p_align?s.p_align:PAGE;if(d.virtual_address<low)low=d.virtual_address;uint64_t ae=0;if(!up(end,&ae))return -8;if(ae>high)high=ae;}if(!n||p.entry<low||p.entry>=high)return -9;p.segment_count=n;p.image_low=low;p.image_high=high;for(uint32_t i=0;i<CHIMERA_PROCESS_MAX;i++)if(!slots[i].used){p.pid=next_pid++;if(!next_pid)next_pid=1;p.state=CHIMERA_PROCESS_ADMITTED;slots[i].image=p;slots[i].used=true;++count;*out=p;return (int)p.pid;}return -10;}
