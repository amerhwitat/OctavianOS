#!/usr/bin/env python3
"""VoiceConnect broker: publishes call/transport state for the desktop app.

This is a local state publisher, not a SIP/RTP stack. The desktop app owns the
UI and the WebRTC/microphone session; the broker reports transport readiness so
the UI can show honest online/offline badges.
"""
import json
import os
import socket
import time

STATE = "/run/aurora/voiceconnect.status"


def reachable(host="1.1.1.1", port=53, timeout=1.5):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def main():
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    while True:
        payload = {
            "service": "org.chimera.Aurora.VoiceConnect",
            "transport": "webrtc+local",
            "network": "online" if reachable() else "offline",
            "ts": int(time.time()),
        }
        tmp = STATE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(payload, handle)
        os.replace(tmp, STATE)
        time.sleep(10)


if __name__ == "__main__":
    main()
