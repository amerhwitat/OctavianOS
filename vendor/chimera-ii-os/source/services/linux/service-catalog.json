{
  "schema": "CHM-LINUX-SERVICE-CATALOG-1",
  "policy": {
    "default_install": [
      "systemd-journald",
      "systemd-udevd",
      "dbus",
      "cron"
    ],
    "never_enable_without_admin": [
      "sshd",
      "smbd",
      "nmbd",
      "wsdd",
      "avahi-daemon",
      "nfs-server",
      "rpcbind",
      "sssd",
      "nginx",
      "apache2",
      "postgresql",
      "mariadb",
      "redis-server",
      "docker",
      "containerd"
    ],
    "package_manager": "apt"
  },
  "profiles": {
    "base": [
      "systemd-journald",
      "systemd-udevd",
      "dbus",
      "cron",
      "systemd-timesyncd",
      "systemd-logind",
      "polkit",
      "rsyslog",
      "chrony"
    ],
    "desktop": [
      "udisks2",
      "accounts-daemon",
      "cups",
      "avahi-daemon",
      "bluetooth",
      "fwupd",
      "gdm3",
      "lightdm",
      "pulseaudio",
      "thermald",
      "acpid",
      "colord",
      "geoclue-2.0",
      "power-profiles-daemon"
    ],
    "network": [
      "NetworkManager",
      "systemd-resolved",
      "avahi-daemon",
      "wsdd",
      "samba",
      "openssh-server",
      "ModemManager",
      "systemd-networkd",
      "openvpn",
      "xrdp",
      "frr"
    ],
    "server": [
      "openssh-server",
      "nginx",
      "fail2ban",
      "logrotate",
      "unattended-upgrades",
      "postfix",
      "dovecot",
      "bind9",
      "cockpit",
      "prometheus-node-exporter",
      "frr"
    ],
    "storage": [
      "udisks2",
      "smartmontools",
      "nfs-kernel-server",
      "rpcbind",
      "samba"
    ],
    "security": [
      "apparmor",
      "auditd",
      "fail2ban",
      "ufw",
      "fwupd"
    ],
    "developer": [
      "docker",
      "postgresql",
      "redis-server"
    ]
  },
  "services": [
