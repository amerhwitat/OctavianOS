# CHIMERA-SECURE-SMB-CONFIG\n[global]
   workgroup = WORKGROUP
   server role = standalone server
   server min protocol = SMB2_10
   server max protocol = SMB3
   server signing = mandatory
   map to guest = never
   guest account = nobody
   disable netbios = yes
   interfaces = lo
   bind interfaces only = yes\n   smb ports = 445
   restrict anonymous = 2
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 1000

# No shares are exported by default. Administrators must add explicit paths,
# valid users and read/write policy before enabling smbd.
