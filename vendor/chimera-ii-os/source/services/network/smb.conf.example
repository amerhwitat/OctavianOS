# Review and merge into /etc/samba/smb.conf; do not overwrite local policy.
[global]
   workgroup = WORKGROUP
   server role = standalone server
   security = user
   map to guest = never
   server min protocol = SMB2_10
   client min protocol = SMB2_10
   server max protocol = SMB3
   client max protocol = SMB3
   smb ports = 445
   disable netbios = yes
   server signing = mandatory
   smb encrypt = desired
   restrict anonymous = 2
   usershare allow guests = no
   load printers = no
   printing = bsd
   printcap name = /dev/null
   log file = /var/log/samba/log.%m
   max log size = 1000

[public]
   comment = Administrator-managed shared data
   path = /srv/smb/public
   browseable = yes
   read only = yes
   guest ok = no
   valid users = @smbusers
