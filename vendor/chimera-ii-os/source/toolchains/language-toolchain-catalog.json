  "purpose": "Unified language, compiler, interpreter, assembler, disassembler and binary-tool capability catalog shared by ChimeraIIOS and OctavianOS.",
  "policy": {
    "catalog_is_not_installation_proof": true,
    "install_mode": "explicit-user-request",
    "default_iso_payload": "core-native-toolchain-only",
    "optional_language_profiles": "package-manager-or-signed-provider",
    "verify_package_signature_or_digest": true,
    "proprietary_tools": "external-installation-only",
    "do_not_claim_native_abi_without_runtime_and_sysroot": true,
    "cross_compile_requires_target_backend_sysroot_and_linker": true,
    "wasm_is_not_a_native_cpu_abi": true
