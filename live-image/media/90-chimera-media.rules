# Trigger media discovery after optical/removable block devices are added.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", TAG+="systemd", ENV{SYSTEMD_WANTS}+="chimera-media-scan.service"
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", TAG+="systemd", ENV{SYSTEMD_WANTS}+="chimera-media-scan.service"
