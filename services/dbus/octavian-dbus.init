#!/bin/sh
### BEGIN INIT INFO
# Provides:          octavian-dbus
# Required-Start:    $local_fs $syslog dbus
# Required-Stop:     $local_fs $syslog dbus
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Koronos D-Bus status service
### END INIT INFO
set -eu
SERVICE=octavian-dbus.service
case "${1:-status}" in
  start)   exec systemctl start "$SERVICE" ;;
  stop)    exec systemctl stop "$SERVICE" ;;
  restart) exec systemctl restart "$SERVICE" ;;
  status)  exec systemctl status "$SERVICE" --no-pager ;;
  *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
