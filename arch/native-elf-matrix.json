{
  "schema": "chimera-native-elf-matrix-v1",
  "policy": {
    "release_mode": "fail-closed",
    "boot_selection": "firmware-mode-and-CPU-architecture-are-independent",
    "rule": "select only an image whose ELF e_machine, class, byte order, ABI and required CPU features match the detected execution environment; never execute a mismatched ELF or silently fall back to emulation",
    "firmware_architecture_source": "The BIOS/UEFI mode selects the firmware entry path; it does not by itself identify the CPU ISA. The bootloader must use its compiled target and a validated CPUID/device-tree/firmware architecture source.",
