{
  "schema": "cross-platform-desktop-app-catalog/v1",
  "purpose": "Discoverable application inventory for Aurora Wayland Glass Desktop and Marine Desktop, informed by common Windows, Linux and macOS desktop workflows.",
  "policy": {
    "catalog_is_not_installation": true,
    "catalog_is_not_compatibility_proof": true,
    "no_proprietary_binaries_without_redistribution_rights": true,
    "verify_upstream_license_and_source_revision_before_import": true,
    "install_only_through_trusted_provider": true,
    "sandbox_untrusted_apps": true,
    "status_values": [
      "catalog-only",
      "source-reviewed",
      "imported",
      "build-verified",
      "launch-verified",
      "supported",
      "blocked"
    ]
  },
