{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octavianos.example/schemas/app-manifest.schema.json",
  "title": "OctavianOS application manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "source", "license", "runtime", "architectures", "launch_method", "entrypoint", "permissions", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "format": "uri"},
    "source_commit": {"type": "string"},
    "license": {"type": "string", "minLength": 1},
    "runtime": {"type": "string", "enum": ["native", "web", "python", "node", "jvm", "container", "vm", "remote", "compatibility"]},
    "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "launch_method": {"type": "string", "enum": ["native", "web", "container", "vm", "remote", "compatibility"]},
    "entrypoint": {"type": "string", "minLength": 1},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["files.read", "files.write", "network.client", "network.server", "audio", "video", "gpu", "devices", "clipboard"]}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "health_check": {"type": "string"},
    "status": {"type": "string", "enum": ["inventory", "imported", "building", "experimental", "supported", "blocked", "unavailable"]}
  }
}
